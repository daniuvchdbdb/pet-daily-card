.reminders-page {
  padding-bottom: 140rpx;
}

.reminder-hero {
  min-height: 190rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background:
    radial-gradient(circle at 86% 20%, rgba(255, 111, 143, 0.18), transparent 150rpx),
    linear-gradient(135deg, #fffafa 0%, #fff8ef 100%);
}

.calendar-icon {
  width: 116rpx;
  height: 116rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f5;
  font-size: 54rpx;
  box-shadow: 0 12rpx 26rpx rgba(255, 111, 143, 0.14);
}

.summary-copy {
  flex: 1;
}

.summary-title {
  color: var(--theme-text, #3a2a2a);
  font-size: 30rpx;
  font-weight: 900;
}

.summary-count {
  margin-top: 6rpx;
  color: var(--theme-text, #3a2a2a);
  font-size: 48rpx;
  font-weight: 950;
}

.summary-sub {
  color: var(--theme-subtle, #8a7772);
  font-size: 24rpx;
}

.hero-dog {
  width: 110rpx;
  height: 110rpx;
  opacity: 0.36;
}

.page-main-action {
  margin-top: 26rpx;
}

.filter-card {
  margin-top: 32rpx;
  margin-bottom: 32rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: var(--theme-text, #3a2a30);
  font-size: 26rpx;
  font-weight: 850;
}

.form-value {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  color: var(--theme-text, #3a2a30);
}

.section {
  margin-top: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: var(--theme-text, #3a2a30);
  font-size: 32rpx;
  font-weight: 900;
}

.section-more {
  color: var(--theme-primary-text, #b65a7a);
  font-size: 24rpx;
  font-weight: 800;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reminder-card {
  padding: 28rpx;
}

.reminder-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.type-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-primary-text, #b65a7a);
  background: var(--theme-soft, #ffe6f0);
  font-size: 30rpx;
  font-weight: 900;
}

.reminder-main {
  flex: 1;
  min-width: 0;
}

.reminder-title {
  color: var(--theme-text, #3a2a30);
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 850;
}

.reminder-meta,
.next-run {
  margin-top: 8rpx;
  color: var(--theme-subtle, rgba(58, 42, 48, 0.58));
  font-size: 23rpx;
  line-height: 1.35;
}

.reminder-status {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.status-tag {
  min-height: 44rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
}

.status-tag.done {
  color: #2f8f4e;
  background: rgba(91, 190, 120, 0.14);
}

.status-tag.pending {
  color: var(--theme-primary-text, #b65a7a);
}

.status-tag.off {
  color: #8f8f8f;
  background: rgba(160, 160, 160, 0.14);
}

.health-tip {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  color: var(--theme-primary-text, #b65a7a);
  background: var(--theme-soft, #ffe6f0);
  font-size: 23rpx;
  line-height: 1.5;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.mini-btn {
  flex: 1;
  min-height: 56rpx;
  font-size: 24rpx;
}

.empty-state {
  min-height: 240rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12rpx;
}

.empty-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-soft, #ffe6f0);
  color: var(--theme-primary-text, #b65a7a);
  font-size: 32rpx;
  font-weight: 900;
}

.empty-text {
  color: var(--theme-text, #3a2a30);
  font-size: 30rpx;
  font-weight: 850;
}

.empty-subtext {
  color: var(--theme-subtle, rgba(58, 42, 48, 0.58));
  font-size: 24rpx;
  line-height: 1.45;
}

.empty-action {
  min-width: 180rpx;
  min-height: 62rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.reminder-pink_note {
  background: radial-gradient(circle at 90% 10%, rgba(255, 79, 147, 0.15), transparent 120rpx), var(--theme-card, #ffffff);
}

.reminder-paper_checklist {
  border-style: dashed;
  background:
    linear-gradient(rgba(119, 78, 42, 0.05) 1rpx, transparent 1rpx),
    var(--theme-card, #fffaf0);
  background-size: 100% 34rpx;
}

.reminder-quest_board,
.reminder-divine_tasks {
  color: #fff8dc;
  background: rgba(246, 198, 91, 0.08);
  border-color: rgba(246, 198, 91, 0.26);
}

.reminder-quest_board .summary-title,
.reminder-quest_board .summary-count,
.reminder-quest_board .reminder-title,
.reminder-divine_tasks .summary-title,
.reminder-divine_tasks .summary-count,
.reminder-divine_tasks .reminder-title {
  color: #fff8dc;
}

.reminder-quest_board .summary-sub,
.reminder-quest_board .reminder-meta,
.reminder-quest_board .next-run,
.reminder-divine_tasks .summary-sub,
.reminder-divine_tasks .reminder-meta,
.reminder-divine_tasks .next-run {
  color: rgba(255, 248, 220, 0.68);
}

.reminder-quest_board .type-icon,
.reminder-divine_tasks .type-icon,
.reminder-quest_board .calendar-icon,
.reminder-divine_tasks .calendar-icon {
  color: #241403;
  background: var(--theme-primary);
}
