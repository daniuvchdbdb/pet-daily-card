.profile-page {
  padding-bottom: 160rpx;
}

.user-card {
  padding: 32rpx 28rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 111, 143, 0.18), transparent 150rpx),
    linear-gradient(135deg, #fffafa 0%, #fff8ef 100%);
}

.profile-sticker {
  position: absolute;
  opacity: 0.36;
}

.profile-sticker.balloon {
  right: 46rpx;
  top: 38rpx;
  width: 72rpx;
  height: 72rpx;
}

.profile-sticker.paw {
  right: 62rpx;
  top: 126rpx;
  width: 76rpx;
  height: 76rpx;
}

.user-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 950;
  background: linear-gradient(135deg, #ffd8e2, #ff8fa8);
  border: 8rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 34rpx rgba(255, 111, 143, 0.18);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  color: #3a2a2a;
  font-size: 44rpx;
  font-weight: 950;
}

.plan-pill,
.theme-pill {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #ff5f83;
  background: #fff0f5;
  font-size: 23rpx;
  font-weight: 850;
}

.plan-pill {
  color: #b67512;
  background: rgba(246, 182, 74, 0.16);
}

.stats-card {
  margin-top: 32rpx;
  padding: 24rpx 10rpx;
  border-radius: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 111, 143, 0.10);
}

.stat-item {
  text-align: center;
}

.stat-icon {
  font-size: 34rpx;
}

.stat-num {
  margin-top: 8rpx;
  color: #3a2a2a;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 950;
}

.stat-label {
  margin-top: 8rpx;
  color: #8a7772;
  font-size: 23rpx;
}

.member-card,
.theme-entry {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-icon,
.theme-entry-icon,
.menu-icon {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f5;
  font-size: 38rpx;
}

.member-icon {
  background: linear-gradient(135deg, #ffe4b0, #f6b64a);
}

.member-copy,
.theme-entry-copy {
  flex: 1;
  min-width: 0;
}

.mini-btn {
  min-width: 118rpx;
  min-height: 58rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.plan-list {
  display: flex;
  gap: 18rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.benefit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.benefit-card {
  padding: 22rpx 16rpx;
  min-height: 230rpx;
}

.benefit-card.plus {
  border-color: rgba(255, 111, 143, 0.28);
  box-shadow: 0 16rpx 34rpx rgba(255, 111, 143, 0.12);
}

.benefit-card.pro {
  border-color: rgba(246, 182, 74, 0.34);
  background: linear-gradient(180deg, #fffdf8, #fff6df);
}

.benefit-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 111, 143, 0.10);
  font-size: 34rpx;
}

.benefit-name {
  margin-top: 14rpx;
  color: var(--theme-text, #3a2a2a);
  font-size: 25rpx;
  font-weight: 950;
}

.benefit-item {
  margin-top: 10rpx;
  color: var(--theme-subtle, #8a7772);
  font-size: 21rpx;
  line-height: 1.35;
}

.plan-card {
  flex: 0 0 520rpx;
  min-height: 440rpx;
}

.plan-card.plus {
  border-color: rgba(255, 111, 143, 0.28);
  box-shadow: 0 18rpx 42rpx rgba(255, 111, 143, 0.14);
}

.plan-card.pro {
  border-color: rgba(246, 182, 74, 0.34);
  background: linear-gradient(180deg, #fffdf8, #fff6df);
}

.plan-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.plan-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f5;
  font-size: 48rpx;
}

.plan-name {
  color: #3a2a2a;
  font-size: 30rpx;
  font-weight: 950;
}

.plan-sub {
  margin-top: 8rpx;
  color: #ff5f83;
  font-size: 24rpx;
  font-weight: 850;
}

.plan-items {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.plan-item {
  color: #6f5d58;
  font-size: 24rpx;
}

.plan-bottom {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.plan-price {
  color: #ff5f83;
  font-size: 36rpx;
  font-weight: 950;
}

.plan-card.pro .plan-price {
  color: #f09a24;
}

.plan-btn {
  min-width: 150rpx;
  min-height: 64rpx;
  font-size: 25rpx;
}

.menu-card {
  margin-top: 28rpx;
  padding: 0;
}

.menu-item {
  min-height: 112rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 1rpx solid rgba(246, 182, 74, 0.14);
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-icon {
  width: 58rpx;
  height: 58rpx;
  font-size: 28rpx;
}

.menu-title {
  flex: 1;
  color: #3a2a2a;
  font-size: 29rpx;
  font-weight: 850;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-desc {
  margin-top: 6rpx;
  color: #9a8983;
  font-size: 22rpx;
  line-height: 1.35;
}

.menu-arrow {
  color: #b8aaa5;
  font-size: 42rpx;
}

.contact-row {
  width: 100%;
  margin: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
  box-sizing: border-box;
  border: 0;
}

.contact-row::after {
  border: 0;
}

.profile-social_sticker .user-card {
  background: radial-gradient(circle at 88% 18%, rgba(255, 79, 147, 0.20), transparent 150rpx), linear-gradient(135deg, #fff1f5, #fff9fb);
}

.profile-scrapbook .user-card,
.profile-scrapbook .plan-card {
  border-style: dashed;
  background:
    linear-gradient(rgba(119, 78, 42, 0.05) 1rpx, transparent 1rpx),
    var(--theme-card, #fffaf0);
  background-size: 100% 34rpx;
}

.profile-realm_rpg .user-card,
.profile-divine_legend .user-card,
.profile-realm_rpg .member-card,
.profile-divine_legend .member-card,
.profile-realm_rpg .theme-entry,
.profile-divine_legend .theme-entry,
.profile-realm_rpg .plan-card,
.profile-divine_legend .plan-card,
.profile-realm_rpg .menu-card,
.profile-divine_legend .menu-card {
  color: #fff8dc;
  background: rgba(246, 198, 91, 0.08);
  border-color: rgba(246, 198, 91, 0.26);
}

.profile-realm_rpg .user-name,
.profile-realm_rpg .section-title,
.profile-realm_rpg .plan-name,
.profile-realm_rpg .stat-num,
.profile-realm_rpg .menu-title,
.profile-realm_rpg .benefit-name,
.profile-divine_legend .user-name,
.profile-divine_legend .section-title,
.profile-divine_legend .plan-name,
.profile-divine_legend .stat-num,
.profile-divine_legend .menu-title,
.profile-divine_legend .benefit-name {
  color: #fff8dc;
}

.profile-realm_rpg .page-subtitle,
.profile-realm_rpg .stat-label,
.profile-realm_rpg .plan-item,
.profile-realm_rpg .menu-arrow,
.profile-realm_rpg .menu-desc,
.profile-realm_rpg .benefit-item,
.profile-divine_legend .page-subtitle,
.profile-divine_legend .stat-label,
.profile-divine_legend .plan-item,
.profile-divine_legend .menu-arrow,
.profile-divine_legend .menu-desc,
.profile-divine_legend .benefit-item {
  color: rgba(255, 248, 220, 0.68);
}

.profile-divine_legend .user-card,
.profile-divine_legend .plan-card.pro {
  box-shadow: 0 0 42rpx rgba(248, 216, 122, 0.14), inset 0 0 28rpx rgba(248, 216, 122, 0.08);
}
