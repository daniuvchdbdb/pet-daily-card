.theme-deco {
  position: relative;
}

.theme-xhs-pink .theme-deco::before,
.theme-xhs-share .theme-deco::before,
.theme-sticker-diary .theme-deco::before,
.theme-tianming-god .theme-deco::before {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  font-size: 38rpx;
  font-weight: 900;
  opacity: 0.34;
}

.theme-xhs-pink .theme-deco::before,
.theme-xhs-share .theme-deco::before {
