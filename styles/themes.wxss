  --theme-primary-solid: #ff4f93;
  --theme-soft: #ffe3ee;
  --theme-border: rgba(255, 95, 148, 0.22);
  --theme-shadow: 0 18rpx 36rpx rgba(255, 95, 148, 0.14);
}

.theme-sticker-diary {
  --theme-bg: linear-gradient(rgba(133, 89, 45, 0.045) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(133, 89, 45, 0.045) 1rpx, transparent 1rpx), linear-gradient(180deg, #fff4d6 0%, #fffaf0 100%);
  --theme-card: rgba(255, 252, 242, 0.84);
  --theme-text: #5a341c;
  --theme-subtle: rgba(90, 52, 28, 0.62);
  --theme-primary: linear-gradient(135deg, #f5c45e 0%, #d99032 100%);
  --theme-primary-solid: #d99032;
  --theme-soft: #ffe6bf;
  --theme-border: rgba(119, 78, 42, 0.22);
  --theme-shadow: 0 16rpx 30rpx rgba(112, 72, 34, 0.12);
}

.theme-realm-gold {
  --theme-bg: radial-gradient(circle at 50% 0%, rgba(246, 198, 91, 0.14), transparent 280rpx), linear-gradient(180deg, #1f1206 0%, #080604 100%);
  --theme-card: rgba(246, 198, 91, 0.08);
  --theme-text: #fff8dc;
  --theme-subtle: rgba(255, 248, 220, 0.68);
  --theme-weak: rgba(255, 248, 220, 0.46);
  --theme-primary: linear-gradient(135deg, #fff1a8 0%, #f6c65b 45%, #8e5520 100%);
  --theme-primary-solid: #f6c65b;
  --theme-soft: rgba(246, 198, 91, 0.12);
  --theme-border: rgba(246, 198, 91, 0.28);
  --theme-shadow: 0 0 38rpx rgba(246, 198, 91, 0.10), inset 0 0 24rpx rgba(246, 198, 91, 0.06);
}

.theme-tianming-god {
  --theme-bg: radial-gradient(circle at 50% 0%, rgba(248, 216, 122, 0.20), transparent 330rpx), linear-gradient(180deg, #120804 0%, #050403 100%);
  --theme-card: rgba(248, 216, 122, 0.08);
  --theme-text: #fff8dc;
  --theme-subtle: rgba(255, 248, 220, 0.68);
  --theme-weak: rgba(255, 248, 220, 0.46);
  --theme-primary: linear-gradient(135deg, #fff5b8 0%, #f8d87a 45%, #9f6c23 100%);
  --theme-primary-solid: #f8d87a;
  --theme-soft: rgba(248, 216, 122, 0.14);
  --theme-border: rgba(248, 216, 122, 0.34);
  --theme-shadow: 0 0 48rpx rgba(248, 216, 122, 0.14), inset 0 0 30rpx rgba(248, 216, 122, 0.08);
}

.theme-realm-gold .page,
.theme-tianming-god .page,
.theme-realm-gold,
.theme-tianming-god {
  color: #fff8dc;
}

.theme-realm-gold .section-card,
.theme-tianming-god .section-card,
.theme-realm-gold .form-card,
.theme-tianming-god .form-card {
  background: var(--theme-card);
  border-color: var(--theme-border);
  box-shadow: var(--theme-shadow);
}

.theme-realm-gold .page-title,
.theme-realm-gold .section-title,
.theme-realm-gold .form-label,
.theme-tianming-god .page-title,
.theme-tianming-god .section-title,
.theme-tianming-god .form-label {
  color: #fff8dc;
}

.theme-realm-gold .page-subtitle,
.theme-realm-gold .section-more,
.theme-realm-gold .form-tip,
.theme-tianming-god .page-subtitle,
.theme-tianming-god .section-more,
.theme-tianming-god .form-tip {
  color: rgba(255, 248, 220, 0.68);
}

.theme-realm-gold .primary-btn,
.theme-tianming-god .primary-btn {
  color: #251405;
  background: var(--theme-primary);
  box-shadow: 0 0 30rpx rgba(246, 198, 91, 0.24);
}

.theme-realm-gold .secondary-btn,
.theme-tianming-god .secondary-btn {
  color: var(--theme-primary-solid);
  background: rgba(246, 198, 91, 0.08);
  border-color: var(--theme-border);
}

.theme-xhs-pink .section-card {
  border-style: solid;
}

.theme-xhs-pink .primary-btn {
  background: var(--theme-primary);
  box-shadow: 0 14rpx 26rpx rgba(255, 63, 131, 0.22);
}

.theme-sticker-diary .section-card {
  border-style: dashed;
}

.theme-sticker-diary .primary-btn {
  color: #5a341c;
  background: var(--theme-primary);
}
