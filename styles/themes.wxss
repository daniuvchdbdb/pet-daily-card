.page {
  min-height: 100vh;
  color: var(--theme-text, #333333);
  background: var(--theme-bg, #fff7e8);
}

.section-card,
.card,
.pet-card,
.form-card,
.preview-card {
  background: var(--theme-card, #ffffff);
  border-radius: var(--theme-radius, 32rpx);
  box-shadow: var(--theme-shadow, 0 12rpx 32rpx rgba(255, 111, 163, 0.10));
  color: var(--theme-text, #333333);
  box-sizing: border-box;
}

.primary-btn,
.btn {
  border-radius: 999rpx;
  background: var(--theme-primary, linear-gradient(135deg, #ffb86c, #ff944d));
  color: #ffffff;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-weight: 800;
  box-shadow: var(--theme-btn-shadow, 0 8rpx 18rpx rgba(255, 111, 163, 0.18));
}

.secondary-btn,
.btn.secondary {
  border-radius: 24rpx;
  color: var(--theme-primary-text, #b76524);
  background: var(--theme-soft, rgba(255, 230, 240, 0.78));
  border: 2rpx solid var(--theme-border, rgba(255, 111, 163, 0.18));
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-weight: 700;
}

.ghost-btn,
.btn.ghost {
  border-radius: 24rpx;
  color: var(--theme-subtle, rgba(58, 42, 48, 0.58));
  background: transparent;
  border: 2rpx solid transparent;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.danger-btn,
.btn.danger {
  border-radius: 24rpx;
  color: #c85b47;
  background: rgba(255, 240, 237, 0.86);
  border: 2rpx solid rgba(200, 91, 71, 0.12);
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-title,
.title {
  color: var(--theme-text, #333333);
  font-weight: 800;
}

.theme-subtitle,
.subtle {
  color: var(--theme-subtle, rgba(51, 51, 51, 0.62));
}

.status-tag,
.tag {
  border-radius: 999rpx;
  min-height: 52rpx;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  color: var(--theme-primary-text, #b76524);
  background: var(--theme-soft, rgba(255, 230, 240, 0.78));
  border: 2rpx solid var(--theme-border, rgba(255, 111, 163, 0.18));
  box-sizing: border-box;
}

.status-tag.active,
.tag.active {
  color: #ffffff;
  background: var(--theme-primary-solid, #ff944d);
}

input,
textarea,
picker {
  color: var(--theme-text, #333333);
}

